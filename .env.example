# Variable NAMES only. Copy to .env (git-ignored) and fill in locally. Never commit real values.

# --- Supabase project (hosted, free tier) ---
SUPABASE_PROJECT_REF=            # project reference id, from the dashboard URL
SUPABASE_URL=                    # https://<ref>.supabase.co  (safe to ship to browsers)
SUPABASE_ANON_KEY=               # public by design: every table is protected by RLS (safe in browsers)
SUPABASE_SERVICE_ROLE_KEY=       # SECRET, SERVER ONLY. Bypasses RLS. Never in browser code, never in a NEXT_PUBLIC_/VITE_ variable. Not needed by this repository.

# --- Migrations / CLI (developer machine or protected CI environment only) ---
SUPABASE_ACCESS_TOKEN=           # SECRET, personal access token for `supabase link` / `db push`
SUPABASE_DB_PASSWORD=            # SECRET, database password of the project
DATABASE_URL=                    # SECRET, direct or session-pooler connection string (used by scripts/backup.sh)

# --- Backups (docs/OPERATIONS.md) ---
BACKUP_AGE_RECIPIENT=            # age PUBLIC key ("age1..."); safe to store in CI
BACKUP_DIR=./backups             # output directory
AGE_IDENTITY_FILE=               # path to the age PRIVATE key; keep offline, never in CI or in this repo
RESTORE_DATABASE_URL=            # SCRATCH database only (restore drills)

# --- Local tests (scripts/test-db.sh) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=                      # local test server password
TEST_MODE=shim                   # shim | supabase
